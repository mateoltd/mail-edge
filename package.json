{
  "name": "mail-edge",
  "version": "0.0.0",
  "private": true,
  "description": "Provider-neutral durable mail-edge SDK and reference service",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mateoltd/mail-edge.git"
  },
  "homepage": "https://github.com/mateoltd/mail-edge#readme",
  "bugs": {
    "url": "https://github.com/mateoltd/mail-edge/issues"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.21.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "actions:check": "node ./scripts/check-actions.mjs",
    "api:check": "node ./scripts/check-api.mjs",
    "build": "turbo run build",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=origin/main",
    "commitlint:check": "node ./scripts/check-commitlint.mjs",
    "clean-room:check": "node ./scripts/check-clean-room.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "license:check": "node ./scripts/check-licenses.mjs",
    "lint": "pnpm run lint:root && turbo run lint",
    "lint:boundaries": "depcruise --config ./dependency-cruiser.config.mjs --output-type err-long .",
    "lint:root": "eslint . --max-warnings 0",
    "pack:check": "node ./scripts/check-packages.mjs",
    "repo:check": "node ./scripts/check-repository.mjs",
    "sbom:check": "node ./scripts/generate-sbom.mjs --check",
    "sbom:generate": "node ./scripts/generate-sbom.mjs",
    "test": "turbo run test",
    "typecheck": "tsc -b --pretty false && turbo run typecheck",
    "verify": "pnpm run repo:check && pnpm run commitlint:check && pnpm run format:check && pnpm run lint && pnpm run lint:boundaries && pnpm run typecheck && pnpm run build && pnpm run test && pnpm run knip && pnpm run api:check && pnpm run pack:check && pnpm run actions:check && pnpm run license:check"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@cyclonedx/cdxgen": "12.8.3",
    "@eslint/js": "9.39.5",
    "@microsoft/api-extractor": "7.58.12",
    "@types/node": "24.13.3",
    "dependency-cruiser": "18.2.0",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "3.8.7",
    "eslint-plugin-boundaries": "7.2.0",
    "globals": "17.9.0",
    "knip": "6.32.2",
    "prettier": "3.9.6",
    "publint": "0.3.23",
    "turbo": "2.10.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "yaml": "2.9.0"
  }
}
