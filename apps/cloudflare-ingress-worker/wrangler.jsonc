{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mail-edge-cloudflare-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "env": {
    "staging": {
      "name": "mail-edge-cloudflare-bridge-staging",
      "vars": {
        "MAIL_EDGE_BINDING_HINT": "cloudflare-staging",
        "MAIL_EDGE_HMAC_CURRENT_KEY_ID": "staging-current",
        "MAIL_EDGE_PROVIDER_INSTANCE_ID": "00000000-0000-7000-8000-000000000001",
      },
      "services": [
        {
          "binding": "MAIL_EDGE_SERVICE",
          "service": "mail-edge-service-staging",
        },
      ],
      "secrets_store_secrets": [
        {
          "binding": "MAIL_EDGE_HMAC_CURRENT_SECRET",
          "store_id": "00000000000000000000000000000001",
          "secret_name": "mail-edge-cloudflare-worker-hmac-current",
        },
      ],
      "queues": {
        "consumers": [
          {
            "queue": "mail-edge-cloudflare-feedback-staging",
            "max_batch_size": 100,
            "max_batch_timeout": 5,
            "max_concurrency": 25,
            "max_retries": 5,
            "retry_delay": 30,
            "dead_letter_queue": "mail-edge-cloudflare-feedback-staging-dlq",
          },
        ],
      },
    },
    "production": {
      "name": "mail-edge-cloudflare-bridge-production",
      "vars": {
        "MAIL_EDGE_BINDING_HINT": "cloudflare-production",
        "MAIL_EDGE_HMAC_CURRENT_KEY_ID": "production-current",
        "MAIL_EDGE_PROVIDER_INSTANCE_ID": "00000000-0000-7000-8000-000000000002",
      },
      "services": [
        {
          "binding": "MAIL_EDGE_SERVICE",
          "service": "mail-edge-service-production",
        },
      ],
      "secrets_store_secrets": [
        {
          "binding": "MAIL_EDGE_HMAC_CURRENT_SECRET",
          "store_id": "00000000000000000000000000000002",
          "secret_name": "mail-edge-cloudflare-worker-hmac-current",
        },
      ],
      "queues": {
        "consumers": [
          {
            "queue": "mail-edge-cloudflare-feedback-production",
            "max_batch_size": 100,
            "max_batch_timeout": 5,
            "max_concurrency": 100,
            "max_retries": 5,
            "retry_delay": 30,
            "dead_letter_queue": "mail-edge-cloudflare-feedback-production-dlq",
          },
        ],
      },
    },
  },
}
