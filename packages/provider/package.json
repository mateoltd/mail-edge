{
  "name": "@mail-edge/provider",
  "version": "0.1.0",
  "description": "Provider SPI, activation gates, lifecycle, and dispatch instrumentation for Mail Edge",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "24.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "etc",
    "README.md",
    "schemas"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "api:check": "api-extractor run",
    "build": "tsc -b",
    "lint": "eslint src test scripts --max-warnings 0",
    "schema:check": "corepack pnpm run build && node ./scripts/generate-evidence-schemas.mjs --check",
    "schema:generate": "corepack pnpm run build && node ./scripts/generate-evidence-schemas.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@mail-edge/contracts": "workspace:^",
    "@mail-edge/core": "workspace:^",
    "@sinclair/typebox": "0.34.41",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  }
}
