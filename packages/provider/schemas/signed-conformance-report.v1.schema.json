{
  "$id": "urn:mail-edge:provider-schema:v1:signed-conformance-report",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "report": {
      "$id": "urn:mail-edge:provider-schema:v1:provider-conformance-report",
      "additionalProperties": false,
      "properties": {
        "adapterVersion": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "checks": {
          "items": {
            "$id": "urn:mail-edge:provider-schema:v1:conformance-check-result",
            "additionalProperties": false,
            "properties": {
              "capability": {
                "maxLength": 96,
                "minLength": 1,
                "type": "string"
              },
              "checkId": {
                "maxLength": 96,
                "minLength": 3,
                "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$",
                "type": "string"
              },
              "details": {
                "additionalProperties": false,
                "maxProperties": 32,
                "patternProperties": {
                  "^[a-z][A-Za-z0-9]*$": {
                    "anyOf": [
                      {
                        "maxLength": 256,
                        "type": "string"
                      },
                      {
                        "maximum": 9007199254740991,
                        "minimum": -9007199254740991,
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                },
                "type": "object"
              },
              "evidenceCode": {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9_]*$",
                "type": "string"
              },
              "evidenceDigest": {
                "maxLength": 64,
                "minLength": 64,
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "outcome": {
                "anyOf": [
                  {
                    "const": "pass",
                    "type": "string"
                  },
                  {
                    "const": "fail",
                    "type": "string"
                  }
                ]
              }
            },
            "required": [
              "checkId",
              "capability",
              "outcome",
              "evidenceCode",
              "evidenceDigest"
            ],
            "type": "object"
          },
          "maxItems": 128,
          "minItems": 1,
          "type": "array"
        },
        "descriptorDigest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "environment": {
          "additionalProperties": false,
          "maxProperties": 32,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_.-]*$": {
              "maxLength": 512,
              "type": "string"
            }
          },
          "type": "object"
        },
        "expiresAt": {
          "maxLength": 35,
          "minLength": 20,
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
          "type": "string"
        },
        "fixtureSetDigest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "mode": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "type": "string"
        },
        "observedAt": {
          "maxLength": 35,
          "minLength": 20,
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
          "type": "string"
        },
        "providerId": {
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "region": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "schemaVersion": {
          "const": "v1",
          "type": "string"
        },
        "suiteVersion": {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "suiteVersion",
        "providerId",
        "adapterVersion",
        "mode",
        "region",
        "observedAt",
        "expiresAt",
        "descriptorDigest",
        "fixtureSetDigest",
        "environment",
        "checks"
      ],
      "type": "object"
    },
    "reportDigest": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "v1",
      "type": "string"
    },
    "signature": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "ed25519",
          "type": "string"
        },
        "keyId": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$",
          "type": "string"
        },
        "value": {
          "maxLength": 86,
          "minLength": 86,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "keyId",
        "value"
      ],
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "report",
    "reportDigest",
    "signature"
  ],
  "type": "object"
}
