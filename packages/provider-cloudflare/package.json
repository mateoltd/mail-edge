{
  "name": "@mail-edge/provider-cloudflare",
  "version": "0.1.0",
  "description": "Experimental Cloudflare Email Service adapter for Mail Edge",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "24.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "etc",
    "README.md",
    "scripts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "api:check": "api-extractor run",
    "build": "tsc -b",
    "lint": "eslint src test scripts --max-warnings 0",
    "test": "vitest run",
    "test:live": "node ./scripts/live-qualification.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@mail-edge/provider": "workspace:^"
  },
  "devDependencies": {
    "@mail-edge/conformance": "workspace:^",
    "vitest": "4.1.10"
  }
}
