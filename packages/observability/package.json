{
  "name": "@mail-edge/observability",
  "version": "0.1.0",
  "description": "PII-safe structured telemetry primitives for Mail Edge",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "24.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "etc"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "api:check": "api-extractor run",
    "build": "tsc -b",
    "lint": "eslint src test --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1"
  },
  "devDependencies": {
    "@opentelemetry/sdk-metrics": "2.10.0",
    "vitest": "4.1.10"
  }
}
