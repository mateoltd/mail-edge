{
  "name": "@mail-edge/queue-pg-boss",
  "version": "0.1.0",
  "description": "Transactional pg-boss wakeups and durable repair for Mail Edge",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "24.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "etc"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "api:check": "api-extractor run",
    "build": "tsc -b",
    "lint": "eslint src test --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@mail-edge/core": "workspace:^",
    "pg-boss": "12.27.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/pg": "8.21.0",
    "pg": "8.23.0",
    "vitest": "4.1.10"
  }
}
