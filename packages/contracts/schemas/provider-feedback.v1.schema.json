{
  "$id": "urn:mail-edge:schema:v1:provider-feedback",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attemptId": {
      "$ref": "urn:mail-edge:schema:v1:attempt-id"
    },
    "feedbackEventId": {
      "$ref": "urn:mail-edge:schema:v1:feedback-event-id"
    },
    "kind": {
      "anyOf": [
        {
          "const": "accepted",
          "type": "string"
        },
        {
          "const": "delivered",
          "type": "string"
        },
        {
          "const": "deferred",
          "type": "string"
        },
        {
          "const": "bounced",
          "type": "string"
        },
        {
          "const": "complained",
          "type": "string"
        },
        {
          "const": "suppressed",
          "type": "string"
        },
        {
          "const": "opened",
          "type": "string"
        },
        {
          "const": "clicked",
          "type": "string"
        },
        {
          "const": "unsubscribed",
          "type": "string"
        }
      ]
    },
    "normalizedEvidence": {
      "$ref": "urn:mail-edge:schema:v1:normalized-evidence"
    },
    "occurredAt": {
      "$ref": "urn:mail-edge:schema:v1:rfc3339-timestamp"
    },
    "providerEventKey": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "providerId": {
      "$ref": "urn:mail-edge:schema:v1:provider-id"
    },
    "providerInstanceId": {
      "$ref": "urn:mail-edge:schema:v1:provider-instance-id"
    },
    "providerMessageId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "receivedAt": {
      "$ref": "urn:mail-edge:schema:v1:rfc3339-timestamp"
    },
    "recipient": {
      "maxLength": 512,
      "minLength": 3,
      "type": "string"
    },
    "schemaVersion": {
      "const": "v1",
      "type": "string"
    },
    "sequenceHint": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "feedbackEventId",
    "providerId",
    "providerInstanceId",
    "providerEventKey",
    "kind",
    "occurredAt",
    "receivedAt",
    "normalizedEvidence"
  ],
  "type": "object"
}
