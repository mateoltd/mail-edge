{
  "$id": "urn:mail-edge:schema:v1:rfc3339-timestamp",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "format": "date-time",
  "maxLength": 35,
  "minLength": 20,
  "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
  "type": "string"
}
